# Copy this file to ".env" (in this same backend/ folder) and fill in
# real values. Never commit the real ".env" file -- it's already
# excluded by both the repo's root .gitignore and backend/.gitignore.

# Telegram bot token from @BotFather (e.g. "123456789:AAExampleTokenText")
TELEGRAM_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your personal Telegram numeric chat ID -- the only chat the bot will
# accept commands from. Message @userinfobot or check getUpdates once to
# find it.
CHAT_ID=PASTE_YOUR_TELEGRAM_CHAT_ID_HERE

# Anthropic Admin API key (starts with "sk-ant-admin"). Optional -- if
# left as the placeholder below, Claude usage tracking is disabled and
# the rest of the app runs normally.
ANTHROPIC_ADMIN_KEY=PASTE_YOUR_sk-ant-admin_KEY_HERE

# claude.ai web-app session cookie (the "sessionKey" cookie set when you
# log into claude.ai in a browser) and your organization ID. Used ONLY
# for the "Plan usage limits / Current session % used" card -- a
# completely different, unofficial data source from ANTHROPIC_ADMIN_KEY
# above. Optional -- if left as the placeholders below, that card just
# shows no data and the rest of the app runs normally. Treat
# CLAUDE_SESSION_KEY like a password: it grants full access to your
# claude.ai account, not just usage stats.
CLAUDE_SESSION_KEY=PASTE_YOUR_sessionKey_COOKIE_VALUE_HERE
CLAUDE_ORG_ID=PASTE_YOUR_ORGANIZATION_ID_HERE

# --- Daily habit tracker -> Google Sheets sync (optional) ---
# Archives each day's completed/not-completed habits to a Google Sheet you
# own, as a permanent history outside this app. Fully optional -- if left
# unset, syncing is silently skipped and the rest of the app runs
# normally. No interactive login involved, just a one-time service-account
# setup -- full plain-English walkthrough: docs/GOOGLE_SHEETS_SETUP.md
# GOOGLE_SHEETS_CREDENTIALS_FILE=backend/secrets/google_credentials.json
# GOOGLE_SHEETS_SPREADSHEET_ID=PASTE_YOUR_SPREADSHEET_ID_HERE

# --- Finding your laptop again if its IP changes (optional) ---
# The backend announces its own address on your home network every few
# seconds so the Kindle can reconnect by itself after your router hands
# this machine a different address. On by default; set to 0 to turn it
# off. These beacons are unauthenticated broadcasts on your LAN -- see
# backend/discovery.py and kindle-daemon/src/discovery.lua before
# deciding. Must match discovery_port in the Kindle's src/config.lua.
DISCOVERY_ENABLED=1
DISCOVERY_PORT=8001
